{
  "name": "slop.gallery",
  "displayName": "Slop Gallery",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A living museum of happy accidents. A local-first WebGPU art gallery.",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/slop.gallery.git"
  },
  "imports": {
    "#component/*": "./src/components/*/index.tsx",
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run vite build",
    "build:dev": "bun run vite build --mode development",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:capture-session && bun run test:knot-materials && bun run test:rolldown-plugins && bun run build && bun run check:build",
    "check:build": "bun test/build/worlds.ts",
    "dev": "bun run vite --mode development",
    "lint": "bun --bun eslint .",
    "preview": "bun run vite preview --host 127.0.0.1",
    "test": "bun test --max-concurrency 1 ./test/unit",
    "test:baking": "bun run --cwd packages/vite-plugin-bake-three test",
    "test:capture-session": "bun run --cwd packages/capture-session test",
    "test:knot-materials": "bun run --cwd packages/knot-materials test",
    "test:live": "bun run build && LIVE_TEST=true bun test ./test/live.test.ts",
    "test:live:oculus": "bun run build && LIVE_TEST=true bun test ./test/oculus.live.test.ts",
    "test:live:spawn": "bun run build && LIVE_TEST=true bun test ./test/spawn.live.test.ts",
    "test:rolldown-plugins": "bun test --max-concurrency 1 ./packages/rolldown-plugin-thematic-chunks ./packages/rolldown-plugin-hoist-popular-constants ./packages/rolldown-plugin-bake-branch-component",
    "typecheck": "bun node_modules/typescript-native/bin/tsc --noEmit --noUnusedLocals --noUnusedParameters --pretty false",
    "vite": "bun --bun node_modules/vite/dist/node/cli.js --configLoader native"
  },
  "overrides": {
    "@dimforge/rapier3d-compat": "0.21.0"
  },
  "patchedDependencies": {
    "three@0.187.0": "patches/three@0.187.0.patch",
    "three-bvh-csg@0.0.18": "patches/three-bvh-csg@0.0.18.patch"
  },
  "dependencies": {
    "ai": "7.0.166",
    "branch-component": "0.4.0",
    "canvas-textures": "workspace:*",
    "capture-session": "workspace:*",
    "clsx": "2.1.1",
    "compose-id": "0.2.0",
    "deltable": "workspace:*",
    "disposable-lifetime": "workspace:*",
    "ego-player": "workspace:*",
    "es-toolkit": "1.53.2",
    "fated-random": "workspace:*",
    "flatten-string": "0.2.0",
    "geofency": "workspace:*",
    "knot-materials": "workspace:*",
    "math": "0.1.0",
    "mount-root": "0.5.0",
    "optis": "0.3.0",
    "rapier-body-contact": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.0",
    "read-permalink": "0.4.0",
    "stringify-clank": "0.1.1",
    "telemethree": "workspace:*",
    "telemethree-ego": "workspace:*",
    "telemethree-pause-menu": "workspace:*",
    "three": "0.187.0",
    "three-bvh-csg": "0.0.18",
    "three-fiber-game": "workspace:*",
    "three-mesh-bvh": "0.9.18",
    "three-shadow-cache": "workspace:*",
    "use-audio-queue": "workspace:*",
    "use-graphics-mode": "workspace:*",
    "use-narrator": "workspace:*",
    "use-pause-menu": "workspace:*",
    "victoria-browser-client": "0.4.0",
    "victoria-browser-errors": "workspace:*",
    "vite-plugin-import-voice-sample": "workspace:*",
    "vite-plugin-jxl": "workspace:*",
    "vite-plugin-jxl-headers": "workspace:*",
    "voice-sample-store": "workspace:*",
    "webgpu-capture-bridge": "workspace:*",
    "zustand": "5.1.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@react-three/drei": "11.0.0-alpha.7",
    "@react-three/fiber": "10.0.0-alpha.6",
    "@react-three/rapier": "2.2.0",
    "@react-three/tsl": "10.0.0-alpha.6"
  },
  "devDependencies": {
    "autoprefixer": "10.6.2",
    "browserslist": "4.29.5",
    "caniuse-lite": "1.0.30001823",
    "capture-page": "0.3.0",
    "cssnano-preset-advanced": "10.0.0",
    "eslint": "10.14.0",
    "eslint-config-jaid": "37.1.0",
    "eslint-plugin-branch-component": "workspace:*",
    "forward-slash-path": "0.3.0",
    "fs-extra": "11.4.1",
    "get-free": "0.2.0",
    "msgpackr": "2.1.4",
    "oxc-transform-react": "0.156.0",
    "postcss": "8.5.32",
    "postcss-normalize": "13.0.1",
    "puppeteer-core": "25.16.0",
    "rolldown": "1.2.18",
    "rolldown-plugin-bake-branch-component": "workspace:*",
    "rolldown-plugin-hoist-popular-constants": "workspace:*",
    "rolldown-plugin-thematic-chunks": "workspace:*",
    "sass-embedded": "1.108.1",
    "terser": "5.51.2",
    "traverse-workspace": "0.2.0",
    "tsconfig-jaid-react": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.7",
    "vite-plugin-bake-three": "workspace:*",
    "vite-plugin-browserslist-target": "workspace:*",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0",
    "webmcp-types": "0.1.10",
    "@babel/core": "8.1.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "@types/bun": "1.4.4",
    "@types/fs-extra": "11.0.4",
    "@types/postcss-normalize": "9.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0"
  },
  "workspaces": [
    "packages/*",
    "packages/use-narrator/packages/*",
    "packages/rolldown-plugin-bake-branch-component/packages/*",
    "packages/vite-plugin-bake-three/packages/*",
    "packages/rolldown-plugin-hoist-popular-constants/packages/*",
    "packages/rolldown-plugin-hoist-popular-constants/packages/babel-plugin-hoist-popular-constants/packages/*",
    "packages/vite-plugin-import-voice-sample/packages/*"
  ]
}
